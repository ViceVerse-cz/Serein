+/// Most text kept for ordered labels scrolled out of view, in bytes and labels.
+const RETAINED_BYTES: usize = 4 * 1024 * 1024;
+const RETAINED_LABELS: usize = 4096;
+
+/// Most separate stretches of an ordered selection seen with their current text.
+const COVERED_SPANS: usize = 64;
+
+/// Where a label sits in a list that only lays out its visible items, such as a chat history.
+///
+/// egui pairs the two ends of a selection by the order labels are shown in a pass, and drops the
+/// selection when either end is not shown. A selection whose ends are both in labels shown with
+/// [`LabelSelectionState::ordered_label_text_selection`] is ranked by this order instead, so it
+/// survives its ends scrolling out of view and copies the text it kept for them. It covers only
+/// ordered labels: the labels in between are found by order, not by being shown.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct SelectionOrder {
+    /// The list item, in display order (such as a message id).
+    pub item: u64,
+
+    /// The label's place within its item.
+    pub index: u32,
+}
+
+impl SelectionOrder {
+    fn next(self) -> Option<Self> {
+        match self.index.checked_add(1) {
+            Some(index) => Some(Self { index, ..self }),
+            None => Some(Self {
+                item: self.item.checked_add(1)?,
+                index: 0,
+            }),
+        }
+    }
+
+    fn previous(self) -> Option<Self> {
+        match self.index.checked_sub(1) {
+            Some(index) => Some(Self { index, ..self }),
+            None => Some(Self {
+                item: self.item.checked_sub(1)?,
+                index: u32::MAX,
+            }),
+        }
+    }
+}
+
+/// The selected text of an ordered label, kept while it is out of view.
+#[derive(Clone, Debug)]
+struct Retained {
+    job: Arc<LayoutJob>,
+    bytes: core::ops::Range<usize>,
+    rect: Rect,
+    pass: u64,
+
+    /// What keeping `job` costs, counted against [`RETAINED_BYTES`].
+    charge: usize,
+}
+
+fn job_bytes(job: &LayoutJob) -> usize {
+    size_of::<LayoutJob>()
+        + job.text.capacity()
+        + job.sections.capacity() * size_of::<LayoutSection>()
+}
