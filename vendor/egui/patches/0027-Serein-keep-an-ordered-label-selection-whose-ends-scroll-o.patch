+    pub fn forget_items(&mut self, items: &[u64]) -> bool {
+        let mut items = items.to_vec();
+        items.sort_unstable();
+        items.dedup();
+        let mut touched = false;
+        for state in self.states.values_mut() {
+            touched |= state.forget_items(&items);
+        }
+        touched
+    }
