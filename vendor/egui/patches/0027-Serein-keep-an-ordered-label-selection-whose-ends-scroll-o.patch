+    fn clear_retained(&mut self) {
+        self.retained.clear();
+        self.retained_bytes = 0;
+        self.retained_span = None;
+        self.covered.clear();
+        self.covered_ends = None;
+    }
+
+    /// Track which stretches of an ordered selection `retained` holds current text for.
+    fn update_coverage(&mut self, selection: CurrentSelection) {
+        let (Some(primary), Some(secondary)) = (selection.primary.order, selection.secondary.order)
+        else {
+            return;
+        };
+        let (lower, upper) = if primary <= secondary {
+            (selection.primary, selection.secondary)
+        } else {
+            (selection.secondary, selection.primary)
+        };
+        let span = (primary.min(secondary), primary.max(secondary));
+        if self.retained_span != Some(span) {
+            self.retained
+                .retain(|order, _| span.0 <= *order && *order <= span.1);
+            self.retained_bytes = self.retained.values().map(|retained| retained.charge).sum();
+            self.retained_span = Some(span);
+        }
+
+        match self.covered_ends {
+            Some((old_lower, old_upper))
+                if !old_lower.same_place(&lower) || !old_upper.same_place(&upper) =>
+            {
+                // Only labels whose part of the selection is unchanged keep current text:
+                // those inside both the old and new selection, and an end that did not move.
+                let (Some(old_first), Some(old_last), Some(first), Some(last)) =
+                    (old_lower.order, old_upper.order, lower.order, upper.order)
+                else {
+                    self.covered.clear();
+                    return;
+                };
+                let from = if old_lower.same_place(&lower) {
+                    Some(first)
+                } else {
+                    old_first.max(first).next()
+                };
+                let to = if old_upper.same_place(&upper) {
+                    Some(last)
+                } else {
+                    old_last.min(last).previous()
+                };
+                match from.zip(to) {
+                    Some((from, to)) if from <= to => self.clip_coverage(from, to),
+                    _ => self.covered.clear(),
+                }
+            }
+            Some(_) => self.clip_coverage(span.0, span.1),
+            None => self.covered.clear(),
+        }
+        self.covered_ends = Some((lower, upper));
+
+        // A label shown before an end moved later this pass holds text for the old ends, so
+        // only runs of labels whose selected characters match the final ends count.
+        let mut runs: Vec<(SelectionOrder, SelectionOrder)> = Vec::new();
+        let mut open = false;
+        for &(order, selected, len) in &self.visits {
+            let valid = expected_chars(order, &lower, &upper, len) == selected;
+            match runs.last_mut() {
+                Some(run) if open && valid && run.1 < order => run.1 = order,
+                _ if valid => runs.push((order, order)),
+                _ => {}
+            }
+            open = valid;
+        }
+        for (first, last) in runs {
+            let (first, last) = (first.max(span.0), last.min(span.1));
+            if first <= last {
+                self.covered.push((first, last));
+            }
+        }
+        self.covered.sort_unstable();
+        let mut merged: Vec<(SelectionOrder, SelectionOrder)> = Vec::new();
+        for (first, last) in self.covered.drain(..) {
+            match merged.last_mut() {
+                // Stretches that touch in order have no label between them.
+                Some(previous) if previous.1.next().is_none_or(|after| first <= after) => {
+                    previous.1 = previous.1.max(last);
+                }
+                _ => merged.push((first, last)),
+            }
+        }
+        merged.truncate(COVERED_SPANS);
+        self.covered = merged;
+        for order in core::mem::take(&mut self.unretained) {
+            self.uncover(order, order);
+        }
+    }
+
+    /// Mark `from..=to` as not holding current text.
+    fn uncover(&mut self, from: SelectionOrder, to: SelectionOrder) {
+        if !self
+            .covered
+            .iter()
+            .any(|(first, last)| *first <= to && from <= *last)
+        {
+            return;
+        }
+        let mut covered = Vec::with_capacity(self.covered.len() + 1);
+        for (first, last) in self.covered.drain(..) {
+            if last < from || to < first {
+                covered.push((first, last));
+                continue;
+            }
+            if let Some(before) = from.previous().filter(|before| first <= *before) {
+                covered.push((first, before));
+            }
+            if let Some(after) = to.next().filter(|after| *after <= last) {
+                covered.push((after, last));
+            }
+        }
+        covered.truncate(COVERED_SPANS);
+        self.covered = covered;
+    }
+
+    fn clip_coverage(&mut self, from: SelectionOrder, to: SelectionOrder) {
+        self.covered.retain_mut(|(first, last)| {
+            *first = (*first).max(from);
+            *last = (*last).min(to);
+            first <= last
+        });
+    }
+
+    /// `items` is sorted and deduplicated.
+    fn forget_items(&mut self, items: &[u64]) -> bool {
+        let touched = self.retained_span.is_some_and(|(first, last)| {
+            items
+                .iter()
+                .any(|item| first.item <= *item && *item <= last.item)
+        });
+        if self.retained.is_empty() && self.covered.is_empty() {
+            return touched;
+        }
+        self.retained
+            .retain(|order, _| items.binary_search(&order.item).is_err());
+        self.retained_bytes = self.retained.values().map(|retained| retained.charge).sum();
+        for &item in items {
+            self.uncover(
+                SelectionOrder { item, index: 0 },
+                SelectionOrder {
+                    item,
+                    index: u32::MAX,
+                },
+            );
+        }
+        touched
+    }
+
+    /// Keep what an ordered label has selected, for when it is out of view.
+    fn retain(
+        &mut self,
+        order: SelectionOrder,
+        galley: &Galley,
+        range: Option<CCursorRange>,
+        rect: Rect,
+    ) {
+        let selected = range
+            .filter(|range| !range.is_empty())
+            .map(|range| selected_text_str(galley, &range));
+        let Some(selected) = selected.filter(|selected| !selected.is_empty()) else {
+            if let Some(old) = self.retained.remove(&order) {
+                self.retained_bytes -= old.charge;
+            }
+            return;
+        };
+        let start = selected.as_ptr() as usize - galley.job.text.as_ptr() as usize;
+        let bytes = start..start + selected.len();
+        let pass = self.pass;
+        if let Some(old) = self.retained.get_mut(&order)
+            && Arc::ptr_eq(&old.job, &galley.job)
+            && old.bytes == bytes
+        {
+            old.rect = rect;
+            old.pass = pass;
+            return;
+        }
+        let old = self.retained.get(&order).map(|old| old.charge);
+        let charge = job_bytes(&galley.job);
+        let bytes_after = self.retained_bytes - old.unwrap_or(0) + charge;
+        if RETAINED_BYTES < bytes_after || (old.is_none() && RETAINED_LABELS <= self.retained.len())
+        {
+            // Not kept, so its stretch of the selection cannot be copied out of view.
+            if let Some(old) = self.retained.remove(&order) {
+                self.retained_bytes -= old.charge;
+            }
+            if self.unretained.len() < RETAINED_LABELS {
+                self.unretained.push(order);
+            } else {
+                self.covered.clear();
+            }
+            return;
+        }
+        self.retained_bytes = bytes_after;
+        self.retained.insert(
+            order,
+            Retained {
+                job: galley.job.clone(),
+                bytes,
+                rect,
+                pass,
+                charge,
+            },
+        );
+    }
+
+    /// The retained text in order, or nothing if some of it did not fit or was not seen
+    /// since the selection changed around it.
+    fn retained_text(&self) -> String {
+        let mut text = String::new();
+        let complete = self.retained_span.is_some_and(|(first, last)| {
+            self.covered
+                .iter()
+                .any(|covered| covered.0 <= first && last <= covered.1)
+        });
+        if !complete {
+            return text;
+        }
+        let mut previous: Option<(&SelectionOrder, &Retained)> = None;
+        for (order, retained) in &self.retained {
+            let Some(piece) = retained.job.text.get(retained.bytes.clone()) else {
+                return String::new();
+            };
+            if let Some((previous_order, previous)) = previous {
+                // Placement only compares labels shown in the same pass.
+                if previous_order.item != order.item
+                    || previous.pass != retained.pass
+                    || previous.rect.bottom() <= retained.rect.top()
+                {
+                    text.push('\n');
+                } else if !text.ends_with(char::is_whitespace)
+                    && !piece.starts_with(|c: char| c.is_whitespace() || c.is_ascii_punctuation())
+                {
+                    text.push(' ');
+                }
+            }
+            text.push_str(piece);
+            previous = Some((order, retained));
+        }
+        text
+    }
+
