--- a/crates/egui-winit/src/lib.rs
+++ b/crates/egui-winit/src/lib.rs
@@ -2162,18 +2162,7 @@ fn process_viewport_command(
                 }
             });
         }
-        ViewportCommand::SetTheme(t) => {
