From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 9 Nov 2026 13:03:11 +0100
Subject: [PATCH] egui#8785: Name native windows for screen readers: label the
 AccessKit root with the viewport title

Squashed from https://github.com/emilk/egui/pull/8785 at d4b803b8ff96.
---
 crates/egui/src/context.rs             |  5 +++++
 crates/egui_kittest/tests/accesskit.rs | 23 +++++++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/crates/egui/src/context.rs b/crates/egui/src/context.rs
index 443170ef2..123e2f050 100644
--- a/crates/egui/src/context.rs
+++ b/crates/egui/src/context.rs
@@ -565,6 +565,11 @@ impl ContextImpl {
             let mut root_node = accesskit::Node::new(accesskit::Role::Window);
             let pixels_per_point = viewport.input.pixels_per_point();
             root_node.set_transform(accesskit::Affine::scale(pixels_per_point.into()));
+            // Screen readers name the window after this label.
+            // On Linux (AT-SPI) nothing else names it.
+            if let Some(title) = &viewport.input.viewport().title {
+                root_node.set_label(title.as_str());
+            }
             let mut nodes = IdMap::default();
             nodes.insert(id, root_node);
             viewport.this_pass.accesskit_state = Some(AccessKitPassState {
diff --git a/crates/egui_kittest/tests/accesskit.rs b/crates/egui_kittest/tests/accesskit.rs
index 31d1b852e..59ca1d6b5 100644
--- a/crates/egui_kittest/tests/accesskit.rs
+++ b/crates/egui_kittest/tests/accesskit.rs
@@ -41,6 +41,29 @@ fn empty_ui_should_return_tree_with_only_root_window() {
 
     assert_eq!(*id, output.tree.unwrap().root);
     assert_eq!(root.role(), Role::Window);
+    assert_eq!(root.label(), None, "No viewport title, so no label");
+}
+
+#[test]
+fn root_window_is_labelled_with_the_viewport_title() {
+    let ctx = Context::default();
+    ctx.enable_accesskit();
+
+    let mut raw_input = RawInput::default();
+    raw_input
+        .viewports
+        .get_mut(&raw_input.viewport_id)
+        .unwrap()
+        .title = Some("My app".to_owned());
+
+    let mut output = ctx.run_ui(raw_input, |_ui| {});
+    output.textures_delta.clear(); // Don't panic on drop with unapplied deltas
+    let update = output.platform_output.accesskit_update.unwrap();
+
+    let root_id = update.tree.unwrap().root;
+    let (_, root) = update.nodes.iter().find(|(id, _)| *id == root_id).unwrap();
+    assert_eq!(root.role(), Role::Window);
+    assert_eq!(root.label(), Some("My app"));
 }
 
 #[test]
