{
  "api_version": 1,
  "id": "ventrilo",
  "name": "Ventrilo Mode",
  "version": "1.1.0",
  "author": "Serein contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein/tree/main/examples/extensions/ventrilo",
  "kind": "plugin",
  "capabilities": [
    "interface_ui",
    "storage",
    "guild_directory",
    "channel_directory",
    "voice_state",
    "app_context",
    "voice_connect",
    "voice_control",
    "app_events",
    "data_events"
  ],
  "actions": [
    {"id": "activate", "label": "Restore Ventrilo layout", "surface": "activation"},
    {"id": "show", "label": "Ventrilo Mode settings", "surface": "panel"},
    {"id": "toggle", "label": "Toggle Ventrilo layout", "surface": "panel"},
    {"id": "interface_click", "label": "Interface row", "surface": "panel"},
    {"id": "refresh", "label": "Refresh the Ventrilo tree", "surface": "app_event"}
  ]
}
