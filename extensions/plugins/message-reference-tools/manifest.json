{
  "api_version": 1,
  "id": "message-reference-tools",
  "name": "Message Reference Tools",
  "version": "1.0.0",
  "author": "Equicord/Vencord contributors; Serein port contributors",
  "license": "GPL-3.0-or-later",
  "source": "https://github.com/ViceVerse-cz/Serein/tree/main/extensions/plugins/message-reference-tools",
  "kind": "plugin",
  "capabilities": [
    "selected_message",
    "timeline",
    "message_details",
    "navigation",
    "external_navigation",
    "reactions_control"
  ],
  "actions": [
    {
      "id": "find-reply",
