{
  "manifest": {
    "api_version": 1,
    "id": "golden-theme",
    "name": "Golden Theme",
    "version": "1.0.0",
    "author": "a1.lol",
    "license": "MIT",
    "source": "https://github.com/ViceVerse-cz/Serein",
    "kind": "theme"
  },
  "theme": {
    "dark": {
      "colors": {
        "base": "#100F0E",
        "sidebar": "#161514",
        "chat": "#1C1B19",
        "raised": "#252321",
        "hover": "#302E2B",
        "selected": "#3C3A36",
        "border": "#36332F",
        "text_strong": "#F5EFE6",
        "text": "#D9D2C5",
        "muted": "#968E82",
        "accent": "#F3A712",
        "accent_text": "#1A1405",
        "link": "#E8C373",
        "positive": "#A3BE8C",
        "warning": "#EBCB8B",
        "danger": "#BF616A",
        "mention_bg": "#332612",
        "mention_text": "#F3D899"
