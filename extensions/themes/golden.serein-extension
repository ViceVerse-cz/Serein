        "danger": "#A42C36",
        "mention_bg": "#FCEBC4",
        "mention_text": "#825505"
      }
    },
    "style": {
      "body_size": 16,
      "heading_size": 24,
      "button_size": 15,
      "small_size": 13,
      "monospace_size": 14,
      "item_spacing": [10, 14],
      "button_padding": [18, 10],
      "control_height": 40,
      "widget_radius": 12,
      "window_radius": 16,
      "menu_radius": 12
    }
  }
