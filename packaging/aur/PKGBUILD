  cp -a "$srcdir/usr/share/." "$pkgdir/usr/share/"
  install -m644 "$srcdir/usr/share/doc/serein/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
