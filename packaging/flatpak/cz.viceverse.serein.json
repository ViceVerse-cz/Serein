{
  "app-id": "cz.viceverse.serein",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "serein",
  "rename-icon": "serein",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.kwalletd6",
    "--talk-name=org.kde.kwalletd5",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.kde.KWin",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1"
  ],
  "modules": [
    {
      "name": "patchelf",
      "buildsystem": "autotools",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0.tar.bz2",
          "sha256": "1952b2a782ba576279c211ee942e341748fdb44997f704dd53def46cd055470b"
        }
      ]
    },
    {
      "name": "serein-ffmpeg",
      "buildsystem": "simple",
      "build-commands": [
        "test \"$(uname -m)\" != x86_64 || pkg-config --exists libva libva-drm libdrm",
        "python3 build-ffmpeg.py --prefix /app/serein-ffmpeg --cache-dir . --work-dir build --offline"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz",
          "sha256": "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f",
          "dest-filename": "ffmpeg-7.1.5.tar.xz"
        },
        {
          "type": "file",
          "url": "https://codeload.github.com/cisco/openh264/tar.gz/refs/tags/v2.6.0",
          "sha256": "558544ad358283a7ab2930d69a9ceddf913f4a51ee9bf1bfb9e377322af81a69",
          "dest-filename": "openh264-2.6.0.tar.gz"
        },
        {
          "type": "file",
          "url": "https://codeload.github.com/FFmpeg/nv-codec-headers/tar.gz/refs/tags/n12.2.72.0",
          "sha256": "dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563",
          "dest-filename": "nv-codec-headers-12.2.72.0.tar.gz"
        },
        {
          "type": "file",
          "url": "https://codeload.github.com/GPUOpen-LibrariesAndSDKs/AMF/tar.gz/refs/tags/v1.4.36",
          "sha256": "240a42033babc7920e5476506d5ac0c5628f67908833168e746406808d0ef146",
          "dest-filename": "AMF-1.4.36.tar.gz"
        },
        {
          "type": "file",
          "url": "https://codeload.github.com/KhronosGroup/Vulkan-Headers/tar.gz/refs/tags/v1.3.290",
          "sha256": "f38a653bf93cab7a2a229a53d2d53b1cba9a2819e4c0a7de13c54085bde9bcf5",
          "dest-filename": "Vulkan-Headers-1.3.290.tar.gz"
        },
        {
          "type": "file",
          "url": "https://codeload.github.com/intel/libvpl/tar.gz/refs/tags/v2.14.0",
          "sha256": "7c6bff1c1708d910032c2e6c44998ffff3f5fdbf06b00972bc48bf2dd9e5ac06",
          "dest-filename": "libvpl-2.14.0.tar.gz",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "file",
          "path": "source/scripts/build-ffmpeg.py"
        }
      ]
    },
    {
      "name": "serein",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/run/build/serein/flatpak-rust/bin",
        "env": {
          "CARGO_NET_OFFLINE": "true",
          "CARGO_HOME": "/run/build/serein/flatpak-cargo-home",
          "FFMPEG_DIR": "/app/serein-ffmpeg"
        }
      },
      "build-commands": [
        "test \"$(rustc --version | cut -d ' ' -f 2)\" = 1.98.1",
        "cargo xtask package --format dir",
        "cp -a dist/linux-root/usr/. /app/",
        "rm -rf /app/serein-ffmpeg",
        "rm -f /app/share/icons/hicolor/1024x1024/apps/serein.png",
        "install -Dm644 packaging/flatpak/cz.viceverse.serein.metainfo.xml /app/share/metainfo/cz.viceverse.serein.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "source"
        }
      ]
    }
  ]
}
