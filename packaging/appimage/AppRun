#!/bin/sh
set -eu
# Keep the caller's working directory and the host GTK/WebKit library environment.
# APPIMAGE/APPDIR are supplied by the runtime and identify the writable outer file
# to the in-app updater. Extracted AppDirs deliberately cannot self-update.
appdir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
exec "$appdir/usr/bin/serein" "$@"
